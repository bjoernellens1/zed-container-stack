FROM fedora:42

ENV container=docker \
    PYTHONUNBUFFERED=1

RUN dnf -y update \
    && dnf -y install \
      bash git cmake make gcc gcc-c++ pkgconf-pkg-config \
      libusb1-devel hidapi-devel opencv-devel opencv-python python3 python3-pip python3-numpy \
      v4l-utils usbutils pciutils mesa-dri-drivers mesa-libGL mesa-libGLU glx-utils \
      libX11 libXext libXrender libxkbcommon-x11 xorg-x11-xauth xeyes jq less nano procps-ng findutils \
    && dnf clean all

RUN mkdir -p /opt/src \
    && git clone --depth=1 https://github.com/stereolabs/zed-open-capture.git /opt/src/zed-open-capture \
    && cmake -S /opt/src/zed-open-capture -B /opt/src/zed-open-capture/build -DCMAKE_BUILD_TYPE=Release \
    && cmake --build /opt/src/zed-open-capture/build -j"$(nproc)" \
    && cmake --install /opt/src/zed-open-capture/build \
    && ldconfig

COPY tools /workspace/tools
COPY scripts /workspace/scripts
WORKDIR /workspace
CMD ["bash"]
