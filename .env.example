# Copy to .env and adjust.
# The exact Stereolabs tag changes with SDK/CUDA releases. List tags with:
#   ./scripts/list-zed-tags.sh | grep -E '5\.3|ubuntu24|cuda12|cuda13'
# Current SDK release page lists ZED SDK 5.3 for Ubuntu 22/24/26 and CUDA 12/13.
ZED_BASE_IMAGE=stereolabs/zed:5.3-tools-devel-cuda12.8-ubuntu24.04
ZED_PY_IMAGE=stereolabs/zed:5.3-py-devel-cuda12.8-ubuntu24.04
ZED_ROS_BASE_IMAGE=stereolabs/zed:5.3-tools-devel-cuda12.8-ubuntu24.04

# Host paths. Relative paths are fine with Docker Compose.
DATA_DIR=./data
XAUTHORITY=${HOME}/.Xauthority

# Defaults for recording scripts.
ZED_CAMERA_MODEL=zed2i
ZED_RESOLUTION=HD720
ZED_FPS=30
ZED_DEPTH_MODE=NEURAL_LIGHT
ZED_RECORD_SECONDS=0
