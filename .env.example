# Copy to .env and adjust.
#
# CPU / Intel iGPU / AMD path (default — no NVIDIA required)
# ============================================================
# Use profiles: cpu, intel, amd
#   make cpu-capture SESSION=myrun    # CPU-only depth via OpenCV SGBM
#   make intel-capture SESSION=myrun  # same + OpenCL acceleration via /dev/dri
#
# The opencapture container uses zed-open-capture + OpenCV SGBM.
# Factory calibration is downloaded from Stereolabs on first use (requires internet).
# Depth quality is lower than the NVIDIA NEURAL modes but is properly calibrated.
#
# NVIDIA path (requires NVIDIA GPU + NVIDIA Container Toolkit)
# ============================================================
# Use profiles: nvidia-sdk, nvidia-ros2
#   make record-svo-pose SESSION=myrun
#   make export-rgbd SVO=data/svo/myrun.svo2
#
# SDK image tags — list available tags with:
#   ./scripts/list-zed-tags.sh | grep -E '5\.3|ubuntu24|cuda12|cuda13'
ZED_BASE_IMAGE=stereolabs/zed:5.3-tools-devel-cuda12.8-ubuntu24.04
ZED_PY_IMAGE=stereolabs/zed:5.3-py-devel-cuda12.8-ubuntu24.04
ZED_ROS_BASE_IMAGE=stereolabs/zed:5.3-tools-devel-cuda12.8-ubuntu24.04

# Host paths. Relative paths are fine with Docker Compose.
DATA_DIR=./data
XAUTHORITY=${HOME}/.Xauthority

# Camera model and capture defaults.
ZED_CAMERA_MODEL=zed2
ZED_RESOLUTION=HD720
ZED_FPS=30

# NVIDIA SDK depth mode (ignored on CPU/Intel/AMD path).
ZED_DEPTH_MODE=NEURAL_LIGHT
ZED_RECORD_SECONDS=0

# OpenCV SGBM tuning for CPU/Intel/AMD depth.
# num_disp: must be a multiple of 16. Higher = more depth range but slower.
# block_size: odd integer >= 5. Larger = smoother depth, less detail.
ZED_OC_SGBM_NUM_DISP=128
ZED_OC_SGBM_BLOCK_SIZE=7
